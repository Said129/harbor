"music.legal.data" = "आपकी लाइब्रेरी और सुनने का इतिहास इस डिवाइस पर सहेजे जाते हैं। ऑनलाइन खोज और चित्रों के अनुरोध चुने गए प्रदाताओं से संपर्क करते हैं। जुड़ी सेवाओं को उनकी सुविधाओं के लिए ज़रूरी अनुरोध मिलते हैं; सक्षम स्क्रॉब्लिंग आपकी सुनने की गतिविधि साझा करती है। स्रोत में सेवाओं को प्रबंधित या डिस्कनेक्ट करें।";
"music.legal.personal" = "Harbor किसी ट्रैक को ऑफ़लाइन सुनने के लिए सहेज सकता है, गति, पिच और रीवर्ब नियंत्रणों से बनी प्रति सहेज सकता है, और डीजे डेक पर ट्रैक मिक्स कर सकता है। ये सुविधाएँ उस संगीत के लिए हैं जो पहले से आपका है या जिस तक आपकी कानूनी पहुँच है, और इनसे बनी फ़ाइलें केवल आपके निजी उपयोग के लिए हैं। इन्हें साझा करना, प्रकाशित करना या किसी और तरह से पुनर्वितरित करना कॉपीराइट धारकों के अधिकारों का उल्लंघन कर सकता है, और इसकी ज़िम्मेदारी आपकी है। Harbor कोई संगीत होस्ट नहीं करता और किसी रिकॉर्डिंग पर कोई अधिकार नहीं देता।";
"music.legal.personalTitle" = "संगीत सहेजना और रीमिक्स करना";
"music.legal.readFull" = "पूरा विवरण पढ़ें";
"music.legal.saving" = "ये सुविधाएँ उस संगीत के लिए हैं जिस तक आपकी पहले से कानूनी पहुँच है। आपकी सहेजी गई फ़ाइलें, जिनमें गति, पिच और रीवर्ब नियंत्रणों से बनी प्रतियाँ भी शामिल हैं, केवल आपके निजी उपयोग के लिए हैं। इन्हें साझा करना या पुनर्वितरित करना कॉपीराइट का उल्लंघन कर सकता है।";
"music.legal.savingShort" = "उस संगीत के लिए जिस तक आपकी कानूनी पहुँच है। सहेजी गई फ़ाइलें निजी उपयोग के लिए हैं।";
"music.legal.services" = "तृतीय-पक्ष सेवाएँ खाते, सदस्यता और क्षेत्र की अपनी आवश्यकताएँ तय करती हैं। नाम, चित्र और लोगो उनके मालिकों की पहचान करते हैं; वे समर्थन का संकेत नहीं हैं। किसी सेवा को जोड़ने से उसके प्रतिबंध नहीं हटते।";
"music.legal.summary" = "Harbor एक स्वतंत्र संगीत क्लाइंट है। केवल उन फ़ाइलों और सेवाओं का उपयोग करें जिन्हें एक्सेस करने की अनुमति आपके पास है। कैटलॉग में सूचीबद्ध होने से सुनने या पुनर्वितरण के अधिकार नहीं मिलते।";
